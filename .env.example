# OPTX Validator Node — environment template
# Copy to .env and fill in your own values. Never commit a real .env.
# cp .env.example .env

# Validator signing key for AARON attestation proofs
AARON_VALIDATOR_KEY=<your-validator-key>

# Solana devnet RPC endpoint (e.g. a Helius devnet URL with your API key)
RPC_URL=<your-rpc-url>

# Target network for the validator (devnet | mainnet)
NETWORK=devnet
